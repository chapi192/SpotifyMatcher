# Use development for direct local/LAN HTTP testing. Production enables secure
# session cookies and therefore requires an HTTPS reverse proxy.
APP_ENV=development

SPOTIFY_CLIENT_ID=replace-me
SPOTIFY_CLIENT_SECRET=replace-me
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=replace-with-a-long-random-value

# Relative paths are resolved from the repository root.
MUSIC_DB_PATH=data/wrappednow.sqlite3
